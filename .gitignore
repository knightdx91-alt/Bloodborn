# ── Unity ────────────────────────────────────────────────────────────
# Everything below is generated by Unity and must never be committed.
# Library/ alone can reach tens of gigabytes. If you ever see it in a
# commit, stop and fix it before pushing.
game/[Ll]ibrary/
game/[Tt]emp/
game/[Oo]bj/
game/[Bb]uild/
game/[Bb]uilds/
game/[Ll]ogs/
game/[Uu]serSettings/
game/[Mm]emoryCaptures/
game/[Rr]ecordings/

# Unity generates these from the project; they are not source.
game/*.csproj
game/*.unityproj
game/*.sln
game/*.suo
game/*.user
game/*.userprefs
game/*.pidb
game/*.booproj
game/*.svd
game/*.pdb
game/*.mdb
game/*.opendb
game/*.VC.db
game/sysinfo.txt

# Build outputs
*.apk
*.aab
*.app
*.unitypackage
crashlytics-build.properties

# Asset Store tools, if ever imported
game/[Aa]ssets/[Aa]ssetStoreTools*

# ── Editors / IDEs ───────────────────────────────────────────────────
.vs/
.idea/
.vscode/
*.swp

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── .NET / the simulation library ────────────────────────────────────
sim/**/bin/
sim/**/obj/
*.user

# ── Scratch ──────────────────────────────────────────────────────────
scratch/
*.tmp
