# ── Godot ────────────────────────────────────────────────────────────
# The engine is Godot (L54). The import cache is rebuilt from the
# .import files beside each asset, which ARE source and are committed.
prototype/.godot/
prototype/android/build/

# ...with one exception. assets/kaykit/ is 911 models that this game
# cannot use (chibi -- see assets/SPEC-asset-packs-v1.md and the renders
# in assets/evidence/). The pack is kept for reference, but importing it
# generates 1366 .import files and extracted textures, and committing
# those for something that will never ship is noise in every diff.
# Delete assets/kaykit/ and this stanza together if the pack goes.
prototype/assets/kaykit/**/*.import
prototype/assets/kaykit/**/*_texture.png

prototype/.mono/
prototype/mono_crash.*

# Build outputs. The web export goes straight to docs/ and IS committed
# — see prototype/export_presets.cfg — because GitHub Pages serves it.
*.apk
*.aab
*.app
*.pck
*.exe
*.dmg
!docs/*.pck

# ── Editors / IDEs ───────────────────────────────────────────────────
.vs/
.idea/
.vscode/
*.swp

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── .NET / the simulation library ────────────────────────────────────
sim/**/bin/
sim/**/obj/
*.user

# ── Scratch ──────────────────────────────────────────────────────────
scratch/
*.tmp

# Staging dir for the web export, from before it went straight to docs/.
prototype/build/

# Throwaway verification harnesses. demo.gd and spar.gd are kept on
# purpose and are not these; anything called shot.* is a scratch render.
prototype/shot.gd
prototype/shot.tscn
