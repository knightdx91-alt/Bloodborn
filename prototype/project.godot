; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marrowmark — Stage 1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[input_devices]

; Off. The game reads touch directly, and with this on every tap also
; arrives as a left click, which fired a swing on press and then blocked
; the second-finger dodge. Comments here must start with ';' -- a '#'
; line is a parse error that silently drops the key beneath it, which is
; exactly how this was missed the first time.
pointing/emulate_mouse_from_touch=false

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
