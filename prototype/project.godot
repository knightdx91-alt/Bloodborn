; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marrowmark — Stage 1"
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

; InputMode watches every event and reports whether the player is on a
; pad, a thumb or a keyboard. An autoload because it has to survive
; scene changes and see events before any scene consumes one.
InputMode="*res://input_mode.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[input]

; ui_accept and ui_cancel get a GAMEPAD BUTTON, which Godot's defaults
; do not give them.
;
; Out of the box, ui_up and ui_down carry the d-pad and the left stick,
; but ui_accept carries Enter, Keypad Enter and Space and nothing else.
; So a pad can move the highlight around a menu and can never press
; anything on it — which reads, entirely reasonably, as "the controller
; does nothing", even while the game is detecting it happily.
;
; The keyboard events are repeated here because defining an action in
; this file REPLACES Godot's built-in one rather than adding to it.
; Leaving them out would fix the pad by breaking Enter and Space.
;
; A accepts, B cancels: the Xbox convention, and the one every Android
; handheld follows.

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
