# ── Defaults ─────────────────────────────────────────────────────────
* text=auto

# C# source. Kept as text so it diffs and merges normally.
*.cs diff=csharp text

# ── Unity scene and asset files ──────────────────────────────────────
# These are YAML. Keep them TEXT (readable and diffable) but never let
# git try an ordinary merge on them — use Unity's own merge tool.
# Configure it once with:
#   git config merge.unityyamlmerge.driver \
#     '"/Applications/Unity/Hub/Editor/<VERSION>/Unity.app/Contents/Tools/UnityYAMLMerge" merge -p %O %B %A %A'
*.unity      merge=unityyamlmerge eol=lf
*.prefab     merge=unityyamlmerge eol=lf
*.asset      merge=unityyamlmerge eol=lf
*.mat        merge=unityyamlmerge eol=lf
*.anim       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.physicMaterial merge=unityyamlmerge eol=lf

# .meta files MUST be committed and MUST NOT go to LFS. Unity uses them
# to track every asset; losing one detaches the asset from its settings.
*.meta text eol=lf

# ── Published web build ──────────────────────────────────────────────
# Everything under docs/ is served by GitHub Pages, which hands out LFS
# pointer files rather than the real thing. Unset every filter here so
# the build is stored as plain git objects.
docs/** -filter -diff -merge

# ── Binary assets: stored in git directly, NOT in LFS ──────────────
# This block used to route every image, model, audio and font file to
# Git LFS. It never took effect: `git lfs install` was not run on the
# machines that committed the assets, so all 313 MB of them are plain
# git objects — `git lfs ls-files` lists nothing — and every clone, the
# GitHub Pages build and the Android APK workflow (which checks out
# WITHOUT lfs: true) all depend on that.
#
# Found 2026-10-09 when a fresh container with LFS installed reported
# 48 untouched townsfolk models and textures as "modified": the clean
# filter wanted to rewrite each into a 132-byte pointer, which would
# have shipped stubs to the APK. Rules that describe a policy the repo
# does not follow are worse than none, so they are gone.
#
# If LFS is ever wanted, it is a deliberate migration, not a drift:
# `git lfs migrate import`, `lfs: true` on every checkout step, and the
# GitHub LFS quota (1 GB storage / 1 GB bandwidth a month on the free
# tier, against a 313 MB asset tree) checked first.
